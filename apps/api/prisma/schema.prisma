  appliedSuggestions              DailyPracticeSuggestion[]
  quizAttempt                     QuizAttempt?
  createdAt                       DateTime                       @default(now())

  @@unique([dayId, revision])
  @@index([dayId, trigger, generatedAt])
  @@index([generationSource, generatedAt])
  @@index([previousSummarySourceRevisionId])
  @@index([createdById, createdAt])
}

model DailyPracticePlanItem {
  id                     String                      @id @default(cuid())
  revisionId             String
  revision               DailyPracticePlanRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  ordinal                Int
  source                 DailyPracticePlanItemSource
  questionId             String
  question               QuizQuestion                @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionReviewRevision Int
  questionContentRevision Int?
  sourceRevision         Int?
  reason                 String                      @db.VarChar(500)
  evidenceRefs           Json
  createdAt              DateTime                    @default(now())

  @@unique([revisionId, ordinal])
  @@unique([revisionId, questionId])
  @@index([questionId, revisionId])
  @@index([revisionId, source])
}

model DailyPracticeSuggestion {
  id                 String                        @id @default(cuid())
  targetUserId       String
  targetUser         User                          @relation("DailyPracticeSuggestionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  submittedById      String
  submittedBy        User                          @relation("DailyPracticeSuggestionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  targetPracticeDate DateTime                      @db.Date
  userQuotaKey       String?                       @unique @db.VarChar(191)
  payload            Json
  status             DailyPracticeSuggestionStatus @default(PENDING)
  supersedesId       String?
  supersedes         DailyPracticeSuggestion?      @relation("DailyPracticeSuggestionSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       DailyPracticeSuggestion[]     @relation("DailyPracticeSuggestionSupersession")
  appliedRevisionId  String?
  appliedRevision    DailyPracticePlanRevision?    @relation(fields: [appliedRevisionId], references: [id], onDelete: SetNull)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([targetUserId, targetPracticeDate, createdAt], map: "DailySuggestion_target_date_created_idx")
  @@index([status, targetPracticeDate, createdAt])
  @@index([submittedById, createdAt])
  @@index([supersedesId])
  @@index([appliedRevisionId])
}

model DailyPracticeStrategyAttempt {
  id             String                             @id @default(cuid())
  dayId          String
  day            DailyPracticeDay                   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  planRevisionId String
  planRevision   DailyPracticePlanRevision          @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  strategy       AiTaskStrategy
  status         DailyPracticeStrategyAttemptStatus @default(PENDING)
  aiInvocationId String?                            @unique
  aiInvocation   AiInvocation?                      @relation(fields: [aiInvocationId], references: [id], onDelete: SetNull)
  errorCategory  String?                            @db.VarChar(80)
  errorMessage   String?                            @db.VarChar(500)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  @@unique([dayId, planRevisionId, strategy], map: "DailyStrategyAttempt_day_revision_strategy_key")
  @@index([status, createdAt])
  @@index([planRevisionId, status])
}

model AiConversation {
  id              String                         @id @default(cuid())
  userId          String
  user            User                           @relation(fields: [userId], references: [id])
  subjectId       String?
  subject         Subject?                       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  knowledgeMode   KnowledgeConversationMode?
  title           String                         @db.VarChar(160)
  messages        AiMessage[]
  libraries       AiConversationLibrary[]
  libraryChapters AiConversationLibraryChapter[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, updatedAt, id], map: "AiConversation_user_updated_id_idx")
  @@index([subjectId, knowledgeMode])
}

model AiConversationLibrary {
  conversationId String
  conversation   AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  libraryId      String
  library        KnowledgeLibrary @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@id([conversationId, libraryId])
  @@index([libraryId, conversationId])
}

model AiConversationLibraryChapter {
  conversationId   String
  conversation     AiConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  libraryChapterId String
  libraryChapter   KnowledgeLibraryChapter @relation(fields: [libraryChapterId], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())

  @@id([conversationId, libraryChapterId])
  @@index([libraryChapterId, conversationId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         @db.VarChar(20)
  content        String         @db.LongText
  citations      Json?
  attachments    Json?
  model          String?        @db.VarChar(120)
  tokenCount     Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id], map: "AiMessage_conversation_created_id_idx")
}
