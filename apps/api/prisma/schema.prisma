  nodeCount                  Int                       @default(0)
  estimatedChunkCount        Int                       @default(0)
  imageCount                 Int                       @default(0)
  processedImageBytes        BigInt                    @default(0)
  warningCount               Int                       @default(0)
  errorCount                 Int                       @default(0)
  summary                    Json?
  reservedChunks             Int                       @default(0)
  reservedPoints             Int                       @default(0)
  reservedImages             Int                       @default(0)
  reservedMediaBytes         BigInt                    @default(0)
