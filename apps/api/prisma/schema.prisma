  sourceName                 String                    @db.VarChar(255)
  sourceSize                 Int
  sourceSha256               String                    @db.Char(64)
  status                     KnowledgeImportStatus     @default(PREFLIGHT_PENDING)
  stage                      String                    @default("QUEUED") @db.VarChar(80)
