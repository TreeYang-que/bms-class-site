generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  EDITOR
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  MEMBERS
}

enum KnowledgeKind {
  ARTICLE
  PDF
  DOCX
  MARKDOWN
}

enum KnowledgeLibraryScope {
  SHARED
  PRIVATE
}

enum KnowledgeImportFileType {
  MARKDOWN
  ZIP
}

enum KnowledgeImportStatus {
  PREFLIGHT_PENDING
  PREFLIGHTING
  INVALID
  AWAITING_CONFIRMATION
  INDEX_PENDING
  PROCESSING
  READY
  FAILED
  COMPENSATION_FAILED
  EXPIRED
}

enum KnowledgeImportIssueSeverity {
  ERROR
  WARNING
}

enum KnowledgeImportAssetStatus {
  PLANNED
  PROCESSED
  UPLOADED
  LINKED
  CLEANED
  ORPHANED
}

enum KnowledgeIndexOperation {
  LEGACY_INDEX
  INDEX_VERSION
  DELETE_VERSION_VECTORS
  DELETE_DOCUMENT_VECTORS
  SYNC_VERSION_ACTIVITY
}

enum ImportSourceCleanupStatus {
  RETAINED
  PENDING
  IN_PROGRESS
  CLEANED
  FAILED
}

enum KnowledgeVersionOrigin {
  IMPORT
  REINDEX
}

enum KnowledgeRenderStatus {
  PENDING
  READY
  FAILED
}

enum KnowledgeConversationMode {
  SHARED
  PRIVATE
  COMBINED
}

enum IndexStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizQuestionCategory {
  STANDARD
  KNOWLEDGE_RECALL
}

enum QuizQuestionOrigin {
  MANUAL
  CSV
  AI_GENERATED
}

enum QuizQuestionReviewStatus {
  DRAFT_REVIEW
  APPROVED
  REJECTED
}

enum AiTaskType {
  CHAT_QA
  QUESTION_GENERATION
  SHORT_ANSWER_GRADING
  DAILY_PLAN
  CREDIT_HOUR_REVIEW
  CURRICULUM_MAPPING
}

enum AiTaskStrategy {
  FLASH_NO_THINKING
  FLASH_HIGH
  PRO_HIGH
  PRO_MAX
  VISION_HIGH
}

enum CreditHourType {
  QUALITY
  VOLUNTEER
}

enum CreditHourSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  PENDING_MANUAL_REVIEW
}

enum CreditHourReviewJobStatus {
  PENDING
  RUNNING
  RETRY_PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  STALE
}

enum CreditHourDecisionSource {
  AI
  ADMIN_OVERRIDE
  ADMIN_CREATED
}

enum CreditHourProviderFileDeleteStatus {
  PENDING
  DELETED
  FAILED
  EXPIRED
}

enum CreditHourCleanupStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETE
  FAILED
}

enum AiInvocationStatus {
  RESERVED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum AiUsageSource {
  PROVIDER
  ESTIMATED
}

enum AiQuestionGenerationComplexity {
  SIMPLE
  ASSOCIATIVE
  COMPLEX
  MAX
}

enum AiQuestionGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  INVALID
  FAILED
  CANCELLED
}

enum QuizQuestionSourceReviewStatus {
  NOT_APPLICABLE
  VALID
  REVIEW_REQUIRED
}

enum QuizQuestionReviewAction {
  SAVE_DRAFT
  APPROVE
  REJECT
  SOURCE_REVALIDATE
  REOPEN
}

enum QuizImportFileType {
  CSV
  ZIP
}

enum QuizImportMode {
  BANK
  NEW_PAPER
  APPEND_PAPER
}

enum QuizImportStatus {
  PREFLIGHT_PENDING
  PREFLIGHTING
  AWAITING_CONFIRMATION
  INVALID
  IMPORT_PENDING
  IMPORTING
  COMPLETED
  FAILED
  COMPENSATION_FAILED
  EXPIRED
}

enum QuizImportIssueSeverity {
  ERROR
  WARNING
}

enum QuizImportAssetStatus {
  PLANNED
  UPLOADED
  LINKED
  CLEANED
  ORPHANED
}

enum QuizAttemptStatus {
  DRAFT
  SCORING
  SUBMITTED
  SCORING_FAILED
  ABANDONED
}

enum TeachingProgressChangeType {
  INITIAL
  ADD
  CORRECTION
}

enum PracticeQuestionMappingStatus {
  PENDING
  PROCESSING
  READY
  NEEDS_REVIEW
}

enum UserPracticeInitializationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DailyPracticeCycleStatus {
  BUILDING
  GENERATING
  READY
  PAUSED
  DEGRADED
  FAILED
}

enum DailyPracticeDayStatus {
  PENDING
  PROCESSING
  READY
  LIMITED_CONTENT
  NO_CONTENT
  DEGRADED_READY
  FAILED
  PAUSED
  STARTED
  COMPLETED
  STALE
}

enum DailyPracticePlanTrigger {
  AUTO
  ADMIN_REGENERATE
  ADMIN_PREVIEW
}

enum DailyPracticeGenerationSource {
  PRO_MAX
  PRO_HIGH
  FLASH_HIGH
  DETERMINISTIC
  NO_MODEL
}

enum DailyPracticePlanItemSource {
  PERSONALIZED
  ADMIN_FIXED
}

enum DailyPracticeSuggestionStatus {
  PENDING
  APPLIED
  PARTIALLY_APPLIED
  NOT_APPLIED
  SUPERSEDED
  EXPIRED_SERVICE_PAUSED
}

enum DailyPracticeStrategyAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

model User {
  id                           String                         @id @default(cuid())
  displayName                  String                         @db.VarChar(80)
  studentNumberHash            String                         @unique @db.Char(64)
  studentNumberEncrypted       String                         @db.Text
  passwordHash                 String                         @db.VarChar(255)
  role                         Role                           @default(MEMBER)
  status                       AccountStatus                  @default(PENDING)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  approvedAt                   DateTime?
  sessions                     Session[]
  news                         News[]
  albums                       Album[]
  threads                      ForumThread[]
  forumPosts                   ForumPost[]
  reports                      ForumReport[]
  knowledgeDocuments           KnowledgeDocument[]
  knowledgeLibrariesOwned      KnowledgeLibrary[]             @relation("KnowledgeLibraryOwner")
  knowledgeImportsCreated      KnowledgeImportJob[]           @relation("KnowledgeImportCreator")
  knowledgeImportsConfirmed    KnowledgeImportJob[]           @relation("KnowledgeImportConfirmer")
  quizQuestions                QuizQuestion[]
  quizPapers                   QuizPaper[]
  quizAttempts                 QuizAttempt[]
  quizWrongQuestions           QuizWrongQuestion[]
  quizImports                  QuizImportJob[]
  auditLogs                    AuditLog[]                     @relation("AuditActor")
  aiConversations              AiConversation[]
  aiInvocationsRequested       AiInvocation[]                 @relation("AiInvocationRequester")
  aiQuestionGenerationJobs     AiQuestionGenerationJob[]      @relation("AiQuestionGenerationCreator")
  quizQuestionReviewEvents     QuizQuestionReviewEvent[]      @relation("QuizQuestionReviewer")
  uploadedPhotos               Photo[]                        @relation("PhotoUploader")
  subjectsCreated              Subject[]                      @relation("SubjectCreator")
  dailyPracticeSettingsUpdates DailyPracticeSettings[]        @relation("DailyPracticeSettingsUpdater")
  dailyPracticePausesCreated   DailyPracticeServicePause[]    @relation("DailyPracticePauseCreator")
  dailyPracticePausesCancelled DailyPracticeServicePause[]    @relation("DailyPracticePauseCanceller")
  teachingProgressPublished    TeachingProgress[]             @relation("TeachingProgressPublisher")
  fixedAssignmentsPublished    DailyPracticeFixedAssignment[] @relation("DailyPracticeFixedAssignmentPublisher")
  practiceProfile              UserPracticeProfile?
  knowledgeStates              UserKnowledgeState[]
  chapterStates                UserChapterState[]
  questionStates               UserQuestionState[]
  dailyPracticeDays            DailyPracticeDay[]
  dailyPlanRevisionsCreated    DailyPracticePlanRevision[]    @relation("DailyPracticePlanRevisionCreator")
  dailySuggestionsReceived     DailyPracticeSuggestion[]      @relation("DailyPracticeSuggestionTarget")
  dailySuggestionsSubmitted    DailyPracticeSuggestion[]      @relation("DailyPracticeSuggestionSubmitter")
  creditHourSubmissions        CreditHourSubmission[]          @relation("CreditHourSubmitter")
  creditHourDecisionEvents     CreditHourDecisionEvent[]       @relation("CreditHourDecisionActor")
  creditHourCleanupOperations  CreditHourCleanupOperation[]    @relation("CreditHourCleanupActor")
  creditHourUploadOperations   CreditHourUploadOperation[]     @relation("CreditHourUploadActor")
  creditHourSubmissionBatches  CreditHourSubmissionBatch[]     @relation("CreditHourBatchActor")
  announcementsCreated        Announcement[]                  @relation("AnnouncementCreator")
  announcementsPublished      Announcement[]                  @relation("AnnouncementPublisher")
  announcementReads           AnnouncementRead[]

  @@index([status, role])
}

model CreditHourSubmission {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation("CreditHourSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  type               CreditHourType
  status             CreditHourSubmissionStatus @default(PENDING_REVIEW)
  revision           Int                        @default(1)
  currentReviewCycle Int                        @default(1)
  idempotencyKey     String                     @db.VarChar(191)
  requestHash        String                     @db.Char(64)
  replacesSubmissionId String?
  replacesSubmission CreditHourSubmission?      @relation("CreditHourReplacement", fields: [replacesSubmissionId], references: [id], onDelete: SetNull)
  replacementSubmissions CreditHourSubmission[]  @relation("CreditHourReplacement")
  generation         Int                        @default(1)
  decisionSource     CreditHourDecisionSource?
  decisionReason     String?                    @db.VarChar(500)
  decidedAt          DateTime?
  revisions          CreditHourSubmissionRevision[]
  reviewJobs         CreditHourReviewJob[]
  decisionEvents     CreditHourDecisionEvent[]
  cleanupOperations  CreditHourCleanupOperation[]
  batchId            String?
  batch              CreditHourSubmissionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, type, deletedAt, createdAt, id])
  @@index([userId, type, status, deletedAt, decidedAt, id])
  @@index([type, status, deletedAt, createdAt, id])
  @@index([decidedAt, id])
  @@index([replacesSubmissionId])
}

model CreditHourSubmissionRevision {
  id                String                 @id @default(cuid())
  submissionId      String
  submission        CreditHourSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revision          Int                    @default(1)
  activityName      String                 @db.VarChar(160)
  halfHours         Int
  sourceDescription String                 @db.Text
  requestHash       String                 @db.Char(64)
  evidence          CreditHourEvidence[]
  createdAt         DateTime               @default(now())

  @@unique([submissionId, revision])
  @@index([halfHours])
}

model CreditHourEvidence {
  id                String                       @id @default(cuid())
  revisionId        String
  revision          CreditHourSubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sortOrder         Int
  originalObjectKey String?                      @unique @db.VarChar(500)
  originalData      Bytes?                       @db.LongBlob
  originalMimeType  String                       @db.VarChar(100)
  originalSize      Int
  originalWidth     Int
  originalHeight    Int
  originalSha256    String                       @db.Char(64)
  displayObjectKey  String?                      @unique @db.VarChar(500)
  displayData       Bytes?                       @db.LongBlob
  displayMimeType   String                       @default("image/webp") @db.VarChar(100)
  displaySize       Int
  displayWidth      Int
  displayHeight     Int
  providerFiles     CreditHourProviderFile[]
  createdAt         DateTime                     @default(now())

  @@unique([revisionId, sortOrder])
  @@index([originalSha256])
}

model CreditHourReviewJob {
  id                String                    @id @default(cuid())
  submissionId      String
  submission        CreditHourSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewCycle       Int
  contentRevision   Int
  generation        Int
  status            CreditHourReviewJobStatus @default(PENDING)
  attempts          Int                       @default(0)
  nextAttemptAt     DateTime?
  leaseOwnerToken   String?                   @db.VarChar(191)
  leasedUntil       DateTime?
  errorCategory     String?                   @db.VarChar(80)
  errorMessage      String?                   @db.VarChar(500)
  completedAt       DateTime?
  reviewAttempts    CreditHourReviewAttempt[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([submissionId, reviewCycle])
  @@index([status, nextAttemptAt, createdAt])
  @@index([leaseOwnerToken, leasedUntil])
}

model CreditHourReviewAttempt {
  id                String                    @id @default(cuid())
  jobId             String
  job               CreditHourReviewJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt           Int
  aiInvocationId    String?                   @db.VarChar(191)
  model             String                    @db.VarChar(100)
  strategy          AiTaskStrategy            @default(VISION_HIGH)
  promptVersion     String                    @db.VarChar(80)
  decision          String?                   @db.VarChar(20)
  userReason        String?                   @db.VarChar(500)
  fieldSummary      Json?
  riskCodes         Json?
  inputHash         String                    @db.Char(64)
  outputHash        String?                   @db.Char(64)
  errorCategory     String?                   @db.VarChar(80)
  errorMessage      String?                   @db.VarChar(500)
  providerFiles     CreditHourProviderFile[]
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())

  @@unique([jobId, attempt])
  @@index([aiInvocationId])
}

model CreditHourProviderFile {
  id                String                             @id @default(cuid())
  attemptId         String
  attempt           CreditHourReviewAttempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evidenceId        String
  evidence          CreditHourEvidence                 @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  providerFileId    String                             @db.VarChar(191)
  expiresAt         DateTime
  deleteStatus      CreditHourProviderFileDeleteStatus @default(PENDING)
  deleteAttempts    Int                                @default(0)
  deleteError       String?                            @db.VarChar(500)
  deletedAt         DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt

  @@unique([attemptId, evidenceId])
  @@index([deleteStatus, expiresAt])
}

model CreditHourDecisionEvent {
  id              String                     @id @default(cuid())
  submissionId    String
  submission      CreditHourSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewCycle     Int
  contentRevision Int
  source          CreditHourDecisionSource?
  actorId         String?
  actor           User?                      @relation("CreditHourDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  fromStatus      CreditHourSubmissionStatus
  toStatus        CreditHourSubmissionStatus
  reason          String?                    @db.VarChar(500)
  createdAt       DateTime                   @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
}

enum CreditHourUploadStatus {
  UPLOADING
  COMMITTED
  CLEANUP_PENDING
  CLEANING
  CLEANUP_FAILED
  CLEANED
}

model CreditHourUploadOperation {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation("CreditHourUploadActor", fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey  String                 @db.VarChar(191)
  requestHash     String                 @db.Char(64)
  manifest        Json
  status          CreditHourUploadStatus @default(UPLOADING)
  leaseOwnerToken String?                @db.VarChar(191)
  leasedUntil     DateTime?
  nextAttemptAt   DateTime?
  attempts        Int                    @default(0)
  errorMessage    String?                @db.VarChar(500)
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, idempotencyKey])
  @@index([status, nextAttemptAt, leasedUntil])
}

model CreditHourSubmissionBatch {
  id             String                 @id @default(cuid())
  actorId        String
  actor          User                   @relation("CreditHourBatchActor", fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String                 @db.VarChar(191)
  requestHash    String                 @db.Char(64)
  submissions    CreditHourSubmission[]
  createdAt      DateTime               @default(now())

  @@unique([actorId, idempotencyKey])
}

model CreditHourCleanupOperation {
  id             String                  @id @default(cuid())
  submissionId   String
  submission     CreditHourSubmission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User                    @relation("CreditHourCleanupActor", fields: [createdById], references: [id], onDelete: Restrict)
  reason         String                  @db.VarChar(500)
  status         CreditHourCleanupStatus @default(PENDING)
  manifest       Json
  totalObjects   Int                     @default(0)
  deletedObjects Int                     @default(0)
  errorMessage   String?                 @db.VarChar(500)
  leaseOwnerToken String?                @db.VarChar(191)
  leasedUntil    DateTime?
  nextAttemptAt  DateTime?
  attempts       Int                     @default(0)
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([submissionId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, leasedUntil])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model Announcement {
  id            String             @id @default(cuid())
  title         String             @db.VarChar(160)
  body          String             @db.MediumText
  status        AnnouncementStatus @default(DRAFT)
  revision      Int                @default(1)
  createdById   String
  createdBy     User               @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedById String?
  publishedBy   User?              @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt   DateTime?
  withdrawnAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reads         AnnouncementRead[]

  @@index([status, publishedAt, id])
  @@index([createdAt, id])
}

model AnnouncementRead {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([userId, announcementId])
  @@index([announcementId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.Char(64)
  csrfToken  String   @db.VarChar(96)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, id], map: "Session_expires_id_idx")
}

model Invite {
  id        String   @id @default(cuid())
  codeHash  String   @unique @db.Char(64)
  label     String   @db.VarChar(120)
  active    Boolean  @default(true)
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([active, expiresAt, createdAt], map: "Invite_active_expires_created_idx")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(80)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt, id], map: "AuditLog_created_id_idx")
  @@index([actorId, createdAt, id], map: "AuditLog_actor_created_id_idx")
  @@index([action, createdAt, id], map: "AuditLog_action_created_id_idx")
  @@index([targetType, targetId, createdAt, id], map: "AuditLog_target_created_id_idx")
}

model News {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(160)
  summary     String        @db.VarChar(300)
  body        String        @db.LongText
  bodyFormat  String        @default("HTML_V1") @db.VarChar(20)
  status      ContentStatus @default(DRAFT)
  visibility  Visibility    @default(MEMBERS)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  photos      NewsPhoto[]

  @@index([status, visibility, publishedAt])
}

model Album {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(160)
  description String    @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  photos      Photo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  @@index([archivedAt, createdAt, id], map: "Album_archived_created_id_idx")
}

model Photo {
  id                    String                  @id @default(cuid())
  albumId               String?
  album                 Album?                  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploadedById          String?
  uploadedBy            User?                   @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  objectKey             String?                 @unique @db.VarChar(500)
  data                  Bytes?                  @db.LongBlob
  caption               String                  @default("") @db.VarChar(300)
  mimeType              String                  @db.VarChar(100)
  size                  Int
  width                 Int?
  height                Int?
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  news                  NewsPhoto[]
  quizQuestions         QuizQuestionPhoto[]
  knowledgeImages       KnowledgeVersionImage[]
  knowledgeImportAssets KnowledgeImportAsset[]
  original              PhotoOriginal?

  @@index([albumId, sortOrder])
  @@index([albumId, sortOrder, createdAt, id], map: "Photo_album_sort_created_id_idx")
  @@index([uploadedById, createdAt])
}

model PhotoOriginal {
  photoId   String   @id
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Restrict)
  objectKey String?  @unique @db.VarChar(500)
  data      Bytes?   @db.LongBlob
  mimeType  String   @db.VarChar(100)
  size      Int
  width     Int
  height    Int
  sha256    String   @db.Char(64)
  createdAt DateTime @default(now())
}

model MediaObjectOperation {
  id              String   @id @default(cuid())
  kind            String   @db.VarChar(20)
  status          String   @default("UPLOADING") @db.VarChar(30)
  actorId         String?
  albumId         String?
  photoId         String?
  idempotencyKey  String?  @db.VarChar(191)
  requestHash     String?  @db.Char(64)
  manifest        Json
  leaseOwnerToken String?  @db.VarChar(191)
  leasedUntil     DateTime?
  nextAttemptAt   DateTime?
  completedAt     DateTime?
  attempts        Int      @default(0)
  errorMessage    String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([actorId, albumId, idempotencyKey])
  @@index([status, nextAttemptAt, leasedUntil])
  @@index([photoId])
}

model NewsPhoto {
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([newsId, photoId])
  @@index([photoId])
}

model ForumThread {
  id        String        @id @default(cuid())
  title     String        @db.VarChar(160)
  body      String        @db.LongText
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  pinned    Boolean       @default(false)
  locked    Boolean       @default(false)
  hidden    Boolean       @default(false)
  posts     ForumPost[]
  reports   ForumReport[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([pinned, updatedAt])
}

model ForumPost {
  id        String        @id @default(cuid())
  threadId  String
  thread    ForumThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body      String        @db.LongText
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  reports   ForumReport[]
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
