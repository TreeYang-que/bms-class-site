model KnowledgeImportJob {
  id                         String                    @id @default(cuid())
  createdById                String
  createdBy                  User                      @relation("KnowledgeImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById              String?
  confirmedBy                User?                     @relation("KnowledgeImportConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  libraryId                  String
  library                    KnowledgeLibrary          @relation(fields: [libraryId], references: [id], onDelete: Restrict)
